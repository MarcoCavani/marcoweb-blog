---
import { TURNSTILE_SITE_KEY } from '../lib/turnstile'

interface Props {
  compact?: boolean
}
const { compact = false } = Astro.props
---

{compact ? (
  <form id="compact-nl-form" class="flex flex-col gap-2" novalidate>
    <input type="text" name="company" id="compact-nl-company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
    <div class="flex gap-2">
      <input
        type="email"
        id="compact-nl-email"
        name="email"
        placeholder="your@email.com"
        required
        class="flex-1 px-3 py-2 rounded-lg bg-gray-800 border border-gray-600 text-white placeholder-gray-500 text-sm focus:outline-none focus:border-brand-blue"
      />
      <button
        type="submit"
        id="compact-nl-btn"
        class="px-3 py-2 bg-brand-blue hover:bg-brand-light text-white rounded-lg text-sm font-medium transition-colors whitespace-nowrap"
      >
        Subscribe
      </button>
    </div>
    <select id="compact-nl-goal" name="goal" class="w-full px-3 py-2 rounded-lg bg-gray-800 border border-gray-600 text-white text-sm focus:outline-none focus:border-brand-blue">
      <option value="" style="color:#111827;background:#fff">What brings you here? (optional)</option>
      <option value="cisa" style="color:#111827;background:#fff">Passing the CISA exam</option>
      <option value="cert" style="color:#111827;background:#fff">CRISC, CISM or another ISACA cert</option>
      <option value="reports" style="color:#111827;background:#fff">Just the security reports</option>
    </select>
    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-size="flexible"></div>
  </form>
  <p id="compact-nl-msg" class="text-xs mt-2" style="display:none"></p>

  <script is:inline>
  (function () {
    var form = document.getElementById('compact-nl-form')
    if (!form) return
    form.addEventListener('submit', async function (e) {
      e.preventDefault()
      var email = document.getElementById('compact-nl-email').value.trim()
      var company = document.getElementById('compact-nl-company').value
      var goal = document.getElementById('compact-nl-goal').value
      var tsEl = document.querySelector('#compact-nl-form [name="cf-turnstile-response"]')
      var token = tsEl ? tsEl.value : ''
      var btn = document.getElementById('compact-nl-btn')
      var msg = document.getElementById('compact-nl-msg')
      if (!email || !email.includes('@')) {
        msg.textContent = 'Enter a valid email.'
        msg.style.color = '#f87171'
        msg.style.display = 'block'
        return
      }
      btn.disabled = true
      btn.textContent = '...'
      try {
        var res = await fetch('/.netlify/functions/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, company: company, goal: goal, turnstileToken: token }),
        })
        if (res.ok) {
          var data = {}
          try { data = await res.json() } catch (e) {}
          form.style.display = 'none'
          msg.textContent = data.pending
            ? 'Almost there. Check your inbox and click the confirmation link.'
            : "You're in! Watch your inbox."
          msg.style.color = '#86efac'
          msg.style.display = 'block'
        } else {
          throw new Error()
        }
      } catch {
        if (window.turnstile) window.turnstile.reset()
        btn.disabled = false
        btn.textContent = 'Subscribe'
        msg.textContent = 'Something went wrong. Try again.'
        msg.style.color = '#f87171'
        msg.style.display = 'block'
      }
    })
  })()
  </script>
) : (
  <div class="bg-brand-navy rounded-2xl p-8 text-white text-center">
    <h3 class="text-2xl font-bold mb-2">Stay ahead of cyber threats</h3>
    <p class="text-gray-300 mb-6 max-w-md mx-auto">
      Get the latest cybersecurity reports, threat intelligence, and IT governance insights delivered straight to your inbox. No spam. Unsubscribe any time.
    </p>

    <div id="nl-form-wrap">
      <form id="nl-form" class="flex flex-col gap-3 max-w-md mx-auto items-center" novalidate>
        <input type="text" name="company" id="nl-company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
        <div class="flex flex-col sm:flex-row gap-3 w-full">
          <input
            type="email"
            id="nl-email"
            name="email"
            placeholder="your@email.com"
            required
            class="flex-1 px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-brand-light focus:bg-white/20 transition-all"
          />
          <button
            type="submit"
            id="nl-btn"
            class="px-6 py-3 bg-brand-blue hover:bg-brand-light text-white font-semibold rounded-xl transition-colors whitespace-nowrap"
          >
            Subscribe Free
          </button>
        </div>
        <select id="nl-goal" name="goal" class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white focus:outline-none focus:border-brand-light focus:bg-white/20 transition-all">
          <option value="" disabled selected style="color:#111827;background:#fff">What are you here for?</option>
          <option value="cisa" style="color:#111827;background:#fff">Passing the CISA exam</option>
          <option value="cert" style="color:#111827;background:#fff">CRISC, CISM or another ISACA cert</option>
          <option value="reports" style="color:#111827;background:#fff">Just the security reports</option>
        </select>
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
      </form>
      <p id="nl-error" class="text-red-400 text-xs mt-3" style="display:none">
        Something went wrong. Please try again.
      </p>
    </div>

    <div id="nl-success" style="display:none">
      <p data-succ-title class="text-brand-light text-lg font-semibold mb-1">You're in!</p>
      <p data-succ-body class="text-gray-300 text-sm">Thanks for subscribing. Watch your inbox for the next report.</p>
    </div>

    <p id="nl-fine" class="text-xs text-gray-500 mt-3">No spam. Unsubscribe at any time.</p>
  </div>
)}

<script is:inline>
(function () {
  var form = document.getElementById('nl-form')
  if (!form) return

  form.addEventListener('submit', async function (e) {
    e.preventDefault()
    var email = document.getElementById('nl-email').value.trim()
    var company = document.getElementById('nl-company').value
    var goal = document.getElementById('nl-goal').value
    var tsEl = document.querySelector('#nl-form [name="cf-turnstile-response"]')
    var token = tsEl ? tsEl.value : ''
    var btn = document.getElementById('nl-btn')
    var errorEl = document.getElementById('nl-error')

    if (!email || !email.includes('@')) {
      errorEl.textContent = 'Please enter a valid email address.'
      errorEl.style.display = 'block'
      return
    }
    if (!goal) {
      errorEl.textContent = 'Pick one option so we send you the right emails.'
      errorEl.style.display = 'block'
      return
    }

    btn.disabled = true
    btn.textContent = 'Subscribing…'
    errorEl.style.display = 'none'

    try {
      var res = await fetch('/.netlify/functions/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, company: company, goal: goal, turnstileToken: token }),
      })

      if (res.ok) {
        var data = {}
        try { data = await res.json() } catch (e) {}
        document.getElementById('nl-form-wrap').style.display = 'none'
        document.getElementById('nl-fine').style.display = 'none'
        var succ = document.getElementById('nl-success')
        if (data.pending) {
          succ.querySelector('[data-succ-title]').textContent = 'Almost there!'
          succ.querySelector('[data-succ-body]').textContent = 'Check your inbox and click the confirmation link to finish subscribing.'
        }
        succ.style.display = 'block'
      } else {
        throw new Error('failed')
      }
    } catch {
      if (window.turnstile) window.turnstile.reset()
      btn.disabled = false
      btn.textContent = 'Subscribe Free'
      errorEl.textContent = 'Something went wrong. Please try again.'
      errorEl.style.display = 'block'
    }
  })
})()
</script>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

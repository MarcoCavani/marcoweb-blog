---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import NewsletterSignup from '../components/NewsletterSignup.astro'
import { getCollection } from 'astro:content'
import { buildDomains, OTHER_CERTS, domainHref, examHref } from '../data/cisaDomains'

const all = await getCollection('lessons')
const domains = buildDomains(all)

const totalBuilt = domains.reduce((s, d) => s + d.built, 0)
const totalQuestions = domains.reduce((s, d) => s + d.quizCount, 0)
const firstReady = domains.find(d => d.ready)
---

<Layout
  title="CISA Courses | Free Exam Preparation | MarcoWeb"
  description="Free CISA exam preparation for working IS auditors, one course per exam domain. Video lessons, scenario questions and timed practice exams. CRISC, CISM and CGEIT to follow."
>
  <Header />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <div class="max-w-3xl mb-10">
      <div class="inline-block text-xs font-semibold uppercase tracking-widest text-brand-blue bg-blue-50 px-3 py-1.5 rounded-full mb-4">
        Free CISA preparation
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 leading-tight mb-4">
        Courses
      </h1>
      <p class="text-lg text-gray-500 leading-relaxed">
        Exam preparation for auditors who already do this work and now have to answer questions about
        it the way the exam expects. Organised as one course per exam domain. Choose where to start.
      </p>
      <div class="flex flex-wrap gap-8 sm:gap-10 mt-8">
        <div>
          <div class="text-2xl font-extrabold text-brand-blue tabular-nums">{totalBuilt}</div>
          <div class="text-xs uppercase tracking-wider text-gray-400 mt-1">lessons free</div>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-brand-blue tabular-nums">{totalQuestions}</div>
          <div class="text-xs uppercase tracking-wider text-gray-400 mt-1">exam questions</div>
        </div>
        {firstReady && (
          <div>
            <a href={examHref(firstReady.n)} class="text-2xl font-extrabold text-brand-blue hover:text-brand-navy tabular-nums">Sit →</a>
            <div class="text-xs uppercase tracking-wider text-gray-400 mt-1">a practice exam</div>
          </div>
        )}
      </div>
    </div>

    <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">CISA, the five exam domains</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      {domains.map(d => (
        <li>
          <a href={domainHref(d.n)}
             class="flex h-full flex-col rounded-2xl border border-gray-100 bg-white p-6 shadow-sm hover:shadow-md transition-shadow group">
            <div class="flex items-center gap-3 mb-3">
              <span class="shrink-0 w-8 h-8 rounded-lg bg-blue-50 text-brand-blue text-sm font-bold flex items-center justify-center tabular-nums">
                {d.n}
              </span>
              <span class:list={[
                'text-[11px] font-semibold uppercase tracking-wider tabular-nums px-2 py-1 rounded-full',
                d.ready ? 'text-brand-blue bg-blue-50' : 'text-gray-400 bg-gray-100',
              ]}>
                {d.ready ? (d.complete ? 'Available now' : `${d.built} of ${d.planned} live`) : 'In development'}
              </span>
              <span class="ml-auto text-xs text-gray-400 tabular-nums">{d.weight}% of exam</span>
            </div>
            <h3 class="font-bold text-gray-900 leading-snug group-hover:text-brand-blue transition-colors">
              Domain {d.n}: {d.title}
            </h3>
            <p class="text-sm text-gray-500 mt-2 leading-relaxed flex-1">{d.blurb}</p>
            <span class="mt-4 text-sm font-semibold text-brand-blue inline-flex items-center gap-1">
              {d.ready ? 'Open the course' : 'See what it covers'}
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <section class="mt-14 pt-10 border-t border-gray-200">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">More certifications, in the pipeline</h2>
      <p class="text-sm text-gray-500 leading-relaxed max-w-2xl mb-5">
        The same course machine, aimed at the next ISACA certifications. Join the list to hear when
        each one opens.
      </p>
      <ul class="grid gap-4 sm:grid-cols-3">
        {OTHER_CERTS.map(c => (
          <li class="rounded-2xl border border-gray-100 bg-gray-50/70 p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-sm font-bold text-gray-700">{c.code}</span>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 bg-gray-200/70 px-2 py-0.5 rounded-full">Planned</span>
            </div>
            <p class="text-xs text-gray-500 leading-relaxed">{c.name}. {c.blurb}</p>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-14 pt-8 border-t border-gray-200 text-xs text-gray-400 leading-relaxed">
      Independent training produced by Marco Cavani. Not affiliated with, endorsed by, or sponsored
      by ISACA. CISA, CRISC, CISM and CGEIT are registered trademarks of ISACA. Course structure
      reflects the published exam content outlines and is not reproduced from ISACA materials.
    </p>

    <div class="mt-14">
      <NewsletterSignup />
    </div>
  </main>

  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<Layout
  title="Contact | MarcoWeb"
  description="Get in touch with Marco Cavani for report requests, collaboration, corrections, or general enquiries about cybersecurity and IT governance."
>
  <Header />

  <main class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <div class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3">Contact</h1>
      <p class="text-lg text-gray-500">
        Questions, report requests, collaboration ideas, or a correction to raise? Send a message below, or email
        <a href="mailto:marco@marcoweb.org" class="text-brand-blue hover:underline">marco@marcoweb.org</a> directly.
      </p>
    </div>

    <!-- Success state (shown after a successful Netlify Forms submission) -->
    <div id="contact-success" class="hidden bg-green-50 border border-green-200 rounded-2xl p-8 text-center">
      <div class="text-4xl mb-3">✅</div>
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Thanks, your message is on its way.</h2>
      <p class="text-gray-600">
        I read every message personally and will get back to you at the email address you provided. In the meantime, browse the
        <a href="/blog" class="text-brand-blue hover:underline">latest articles</a>.
      </p>
    </div>

    <!-- Contact form. Submits via fetch to the contact function (see the script
         below), which emails the message through Brevo. -->
    <form
      id="contact-form"
      class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8 space-y-5"
    >
      <!-- Honeypot: bots fill this hidden field; humans never see it -->
      <p class="hidden" aria-hidden="true">
        <label>Leave this field empty: <input name="bot-field" id="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div>
        <label for="name" class="block text-sm font-semibold text-gray-800 mb-1.5">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          class="w-full rounded-xl border border-gray-300 px-4 py-2.5 text-gray-900 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 focus:outline-none transition"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-gray-800 mb-1.5">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          class="w-full rounded-xl border border-gray-300 px-4 py-2.5 text-gray-900 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 focus:outline-none transition"
        />
      </div>

      <div>
        <label for="subject" class="block text-sm font-semibold text-gray-800 mb-1.5">Subject</label>
        <input
          type="text"
          id="subject"
          name="subject"
          required
          class="w-full rounded-xl border border-gray-300 px-4 py-2.5 text-gray-900 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 focus:outline-none transition"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold text-gray-800 mb-1.5">Message</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          class="w-full rounded-xl border border-gray-300 px-4 py-2.5 text-gray-900 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 focus:outline-none transition resize-y"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full bg-brand-blue hover:bg-brand-navy text-white font-semibold px-6 py-3 rounded-xl transition-colors"
      >
        Send message
      </button>

      <p id="contact-error" class="hidden text-sm text-red-600 text-center"></p>

      <p class="text-xs text-gray-400 text-center">
        By submitting this form you agree to our
        <a href="/privacy-policy" class="text-brand-blue hover:underline">Privacy Policy</a>. Your details are used only to respond to your enquiry.
      </p>
    </form>

  </main>

  <Footer />

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null
    const successEl = document.getElementById('contact-success')
    const errorEl = document.getElementById('contact-error')

    function showSuccess() {
      form?.classList.add('hidden')
      successEl?.classList.remove('hidden')
      successEl?.scrollIntoView({ behavior: 'smooth', block: 'center' })
    }

    // Back-compat with any old ?submitted=true link.
    if (new URLSearchParams(window.location.search).get('submitted') === 'true') showSuccess()

    const val = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() || ''

    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      errorEl?.classList.add('hidden')
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement
      const label = btn.textContent
      btn.disabled = true
      btn.textContent = 'Sending...'
      try {
        const res = await fetch('/.netlify/functions/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: val('name'),
            email: val('email'),
            subject: val('subject'),
            message: val('message'),
            'bot-field': (document.getElementById('bot-field') as HTMLInputElement | null)?.value || '',
          }),
        })
        if (!res.ok) throw new Error('failed')
        showSuccess()
      } catch {
        btn.disabled = false
        btn.textContent = label
        if (errorEl) {
          errorEl.textContent = 'Something went wrong. Please email marco@marcoweb.org directly.'
          errorEl.classList.remove('hidden')
        }
      }
    })
  </script>
</Layout>

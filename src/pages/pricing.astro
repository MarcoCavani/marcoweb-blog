---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<Layout
  title="Plans | CISA Mock Exams | MarcoWeb"
  description="Study every CISA domain free. Unlock unlimited timed mock exams with a single one-time payment, no subscription."
>
  <Header />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-2xl mb-10">
      <div class="inline-block text-xs font-semibold uppercase tracking-widest text-brand-blue bg-blue-50 px-3 py-1.5 rounded-full mb-4">
        Plans
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight mb-4">
        Study free. Unlock the mock exams when you are ready.
      </h1>
      <p class="text-lg text-gray-500 leading-relaxed">
        Every lesson and knowledge check is free, always. The one thing you pay for is unlimited
        timed mock exams, and it is a single payment, not a subscription.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 items-start">
      <!-- Free -->
      <div class="rounded-2xl border border-gray-200 bg-white p-8">
        <h2 class="text-lg font-bold text-gray-900">Free</h2>
        <div class="mt-3 mb-1"><span class="text-4xl font-extrabold text-gray-900">€0</span></div>
        <p class="text-sm text-gray-400 mb-6">Everything you need to learn.</p>
        <ul class="space-y-2.5 text-sm text-gray-600 mb-8">
          <li class="flex gap-2"><span class="text-brand-blue">✓</span> All lessons, all five domains</li>
          <li class="flex gap-2"><span class="text-brand-blue">✓</span> Every video and knowledge check</li>
          <li class="flex gap-2"><span class="text-brand-blue">✓</span> 5 mock exam attempts</li>
        </ul>
        <a href="/training" class="block text-center px-5 py-2.5 border border-gray-200 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition-colors">
          Start learning
        </a>
      </div>

      <!-- Pro -->
      <div class="relative rounded-2xl border-2 border-brand-blue bg-white p-8 shadow-sm">
        <span class="absolute -top-3 left-8 text-[11px] font-semibold uppercase tracking-wider text-white bg-brand-blue px-3 py-1 rounded-full">
          Exam ready
        </span>
        <h2 class="text-lg font-bold text-gray-900">Pro</h2>
        <div class="mt-3 mb-1 flex items-baseline gap-2">
          <span class="text-4xl font-extrabold text-gray-900">€39</span>
          <span class="text-sm text-gray-400">one-time</span>
        </div>
        <p class="text-sm text-gray-400 mb-6">90 days of full access. No auto-renew.</p>
        <ul class="space-y-2.5 text-sm text-gray-600 mb-8">
          <li class="flex gap-2"><span class="text-brand-blue">✓</span> Everything in Free</li>
          <li class="flex gap-2"><span class="text-brand-blue">✓</span> <strong class="font-semibold text-gray-800">Unlimited</strong> timed mock exams</li>
          <li class="flex gap-2"><span class="text-brand-blue">✓</span> Scored by domain, so you know where to revise</li>
          <li class="flex gap-2"><span class="text-brand-blue">✓</span> One payment, cancel nothing</li>
        </ul>
        <button id="cta" type="button" class="w-full px-5 py-2.5 bg-brand-blue hover:bg-brand-navy text-white font-semibold rounded-xl transition-colors">
          Unlock mock exams
        </button>
        <p id="cta-note" class="text-xs text-gray-400 mt-3 min-h-[1rem]"></p>
      </div>
    </div>

    <p class="mt-12 pt-8 border-t border-gray-200 text-xs text-gray-400 leading-relaxed">
      Independent training produced by Marco Cavani. Not affiliated with, endorsed by, or sponsored
      by ISACA. CISA is a registered trademark of ISACA. Mock exam questions are written for this
      course and are not reproduced from ISACA materials; no practice result predicts a real exam
      outcome.
    </p>
  </main>

  <Footer />
</Layout>

<script>
  import { getEntitlement } from '../lib/auth'

  const cta = document.getElementById('cta') as HTMLButtonElement
  const note = document.getElementById('cta-note') as HTMLElement
  const disable = (label: string) => {
    cta.textContent = label
    cta.disabled = true
    cta.classList.add('opacity-60', 'cursor-default', 'hover:bg-brand-blue')
  }

  getEntitlement().then((ent) => {
    if (!ent.signedIn) {
      cta.textContent = 'Log in to unlock'
      cta.addEventListener('click', () => { location.href = '/login?next=/pricing' })
      return
    }
    if (ent.admin) { disable('Admin, full access'); return }
    if (ent.plan === 'pro') {
      disable('You have Pro')
      note.textContent = 'Mock exams are unlocked on your account.'
      return
    }
    // Signed in, free tier. Checkout is not wired yet (Stripe is the next step).
    cta.addEventListener('click', () => {
      disable('Coming soon')
      note.textContent = 'Checkout is opening shortly. Thanks for the interest, you will be able to unlock here very soon.'
    })
  })
</script>
